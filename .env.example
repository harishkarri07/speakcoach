# ---------------------------------------------------------------------------
# SpeakCoach environment variables
# Copy this file to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored — never commit it, never hardcode secrets.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY (server only, REQUIRED for chat)
# Google AI Studio -> "Create API key". Used exclusively inside server.ts;
# it is never bundled into the browser (no VITE_ prefix).
GEMINI_API_KEY=your-gemini-api-key

# GEMINI_MODELS (server only, optional)
# Comma-separated fallback order tried when a model fails before any output
# has been streamed. Verified against ai.models.list() at startup.
GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-2.5-flash-lite

# APP_URL (server only, optional)
# Public base URL of this deployment (magic-link / OAuth redirect target).
APP_URL=http://localhost:3000

# PORT (server only, optional) - HTTP port, default 3000.
PORT=3000

# TRUST_PROXY (server only, optional) - Number of proxies in front of the
# server. Drives Express `trust proxy`, which the rate limiter uses to read
# the real client IP. Never read x-forwarded-for manually.
TRUST_PROXY=1

# ALLOW_DEMO_MODE (server only, optional) - "true" lets unauthenticated
# requests reach /api/chat with a demo profile. Only honored when
# NODE_ENV !== 'production'; ignored in production.
ALLOW_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Supabase — server-side pair (used to verify JWTs with auth.getUser(token))
# Project Settings -> API. Keep these OFF the client.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-server-side-anon-key

# ---------------------------------------------------------------------------
# Supabase — client pair (bundled into the browser; safe: RLS protects data)
# Project Settings -> API.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
